local function removeESP(player)
    local data = ESPData[player]
    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    if data.Connection then
        data.Connection:Disconnect()
    end

    ESPData[player] = nil
end

local function createESP(player, character)
    if player == LocalPlayer then
        return
    end

    local data = ESPData[player]
    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        humanoid =
            character:WaitForChild("Humanoid", 5)
    end

    if not humanoid then
        return
    end

    -- Полная модель персонажа
    local highlight = Instance.new("Highlight")
    highlight.Name = "JimboJjosESP"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 50, 50)
    highlight.FillTransparency = 0.2
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0

    if Settings.ESPThroughWalls then
        highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop
    else
        highlight.DepthMode =
            Enum.HighlightDepthMode.Occluded
    end

    highlight.Enabled = Settings.ESP
    highlight.Parent = Gui

    data.Highlight = highlight
    data.Character = character

    -- Имя / дистанция
    local root =
        character:FindFirstChild("HumanoidRootPart")

    if root then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JimboJjosInfo"
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(220, 40)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = Settings.ESP
        billboard.Parent = Gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextStrokeTransparency = 0
        label.TextSize = 12
        label.Font = Enum.Font.GothamBold
        label.Text = player.Name
        label.Parent = billboard

        data.Billboard = billboard
        data.Label = label
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end

    removeESP(player)

    ESPData[player] = {}

    ESPData[player].Connection =
        player.CharacterAdded:Connect(function(character)
            task.wait(0.1)

            if ESPData[player] then
                createESP(player, character)
            end
        end)

    if player.Character then
        createESP(
            player,
            player.Character
        )
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)

    if CurrentTarget == player then
        CurrentTarget = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, data in pairs(ESPData) do
        local character = player.Character

        if character
            and data.Highlight then

            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid and humanoid.Health > 0 then

                data.Highlight.Adornee =
                    character

                data.Highlight.Enabled =
                    Settings.ESP

                data.Highlight.DepthMode =
                    Settings.ESPThroughWalls
                    and Enum.HighlightDepthMode.AlwaysOnTop
                    or Enum.HighlightDepthMode.Occluded

                local root =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if root and data.Billboard then
                    data.Billboard.Adornee = root
                    data.Billboard.Enabled =
                        Settings.ESP

                    local myCharacter =
                        LocalPlayer.Character

                    local myRoot =
                        myCharacter
                        and myCharacter:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if myRoot and data.Label then
                        local distance =
                            (
                                myRoot.Position
                                - root.Position
                            ).Magnitude

                        data.Label.Text =
                            player.Name
                            .. " | "
                            .. math.floor(distance)
                            .. "m"
                    end
                end
            else
                data.Highlight.Enabled = false

                if data.Billboard then
                    data.Billboard.Enabled = false
                end
            end
        end
    end
end)

--========================================================
-- AIMBOT
--========================================================

local function getAimPart(player)
    if not player
        or player == LocalPlayer then
        return nil
    end

    local character = player.Character
    if not character then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid
        or humanoid.Health <= 0 then
        return nil
    end

    local names = {
        "Head",
        "UpperTorso",
        "Torso",
        "HumanoidRootPart"
    }

    for _, name in ipairs(names) do
        local part = character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

local function visible(player, camera)
    if not Settings.WallCheck then
        return true
    end

    local character = player.Character
    local target = getAimPart(player)

    if not character or not target then
        return false
    end

    local origin = camera.CFrame.Position
    local direction = target.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character
    }
    params.IgnoreWater = true

    local result =
        workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(character)
end

local function findTarget()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local viewport = camera.ViewportSize

    local center = Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local selected = nil
    local closest = Settings.FOV

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        local target = getAimPart(player)

        if target
            and visible(player, camera) then

            local screen, onScreen =
                camera:WorldToViewportPoint(
                    target.Position
                )

            if onScreen and screen.Z > 0 then

                local point =
                    Vector2.new(
                        screen.X,
                        screen.Y
                    )

                local distance =
                    (point - center).Magnitude

                if distance <= closest then
                    closest = distance
                    selected = player
                end
            end
        end
    end

    return selected
end

local function aimAt(player)
    local camera =
        workspace.CurrentCamera

    if not camera then
        return false
    end

    local target =
        getAimPart(player)

    if not target then
        return false
    end

    if not visible(player, camera) then
        return false
    end

    local cameraPosition =
        camera.CFrame.Position

    local desired =
        CFrame.lookAt(
            cameraPosition,
            target.Position
        )

    if Settings.Smoothness >= 1 then
        camera.CFrame = desired
    else
        camera.CFrame =
            camera.CFrame:Lerp(
                desired,
                Settings.Smoothness
            )
    end

    return true
end

--========================================================
-- AIM LOOP
--========================================================

RunService:BindToRenderStep(
    "JimboJjosAimbot",
    Enum.RenderPriority.Camera.Value + 1,
    function()

        if not Settings.Aimbot then
            CurrentTarget = nil
            TargetLabel.Text = "Target: None"
            return
        end

        -- Удерживаем текущую цель.
        if CurrentTarget then

            if getAimPart(CurrentTarget)
                and visible(
                    CurrentTarget,
                    workspace.CurrentCamera
                ) then

                aimAt(CurrentTarget)

                TargetLabel.Text =
                    "Target: "
                    .. CurrentTarget.Name

                return
            end

            -- Стена / смерть / исчезновение.
            CurrentTarget = nil
        end

        -- Берём новую цель только внутри FOV.
        CurrentTarget = findTarget()

        if CurrentTarget then
            aimAt(CurrentTarget)

            TargetLabel.Text =
                "Target: "
                .. CurrentTarget.Name
        else
            TargetLabel.Text =
                "Target: None"
        end
    end
)

