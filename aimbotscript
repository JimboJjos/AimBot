--========================================================
-- ESP FUNCTIONS
--========================================================

local function removeESP(player)

	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end

	if data.CharacterConnection then
		data.CharacterConnection:Disconnect()
	end

	ESPObjects[player] = nil
end

local function createESP(player, character)

	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid then
		humanoid =
			character:WaitForChild(
				"Humanoid",
				5
			)
	end

	if not root then
		root =
			character:WaitForChild(
				"HumanoidRootPart",
				5
			)
	end

	if not humanoid or not root then
		return
	end

	--====================================================
	-- FULL BODY HIGHLIGHT
	--====================================================

	local highlight = Instance.new("Highlight")

	highlight.Name = "JimboJjosFullBodyESP"

	-- ВСЯ модель
	highlight.Adornee = character

	highlight.FillColor =
		Color3.fromRGB(255, 50, 50)

	highlight.FillTransparency = 0.15

	highlight.OutlineColor =
		Color3.fromRGB(255, 255, 255)

	highlight.OutlineTransparency = 0

	highlight.DepthMode =
		Config.ESPThroughWalls
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	highlight.Enabled = Config.ESP

	highlight.Parent = ESPFolder

	--====================================================
	-- INFO
	--====================================================

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "JimboJjosInfo"

	billboard.Adornee = root

	billboard.Size =
		UDim2.fromOffset(220, 40)

	billboard.StudsOffset =
		Vector3.new(0, 3.5, 0)

	billboard.AlwaysOnTop = true

	billboard.Enabled =
		Config.ESP and Config.ShowInfo

	billboard.Parent = Gui

	local label = Instance.new("TextLabel")

	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 =
		Color3.fromRGB(255, 255, 255)

	label.TextStrokeTransparency = 0

	label.TextSize = 12
	label.Font = Enum.Font.GothamBold

	label.Text = player.Name

	label.Parent = billboard

	data.Character = character
	data.Highlight = highlight
	data.Billboard = billboard
	data.Label = label
end

local function setupESP(player)

	if player == LocalPlayer then
		return
	end

	removeESP(player)

	local data = {
		Character = nil,
		Highlight = nil,
		Billboard = nil,
		Label = nil,
		CharacterConnection = nil
	}

	ESPObjects[player] = data

	data.CharacterConnection =
		player.CharacterAdded:Connect(
			function(character)

				task.wait(0.1)

				if ESPObjects[player] then
					createESP(
						player,
						character
					)
				end
			end
		)

	if player.Character then

		task.spawn(function()

			createESP(
				player,
				player.Character
			)
		end)
	end
end

for _, player in ipairs(
	Players:GetPlayers()
) do
	setupESP(player)
end

Players.PlayerAdded:Connect(function(player)
	setupESP(player)
end)

Players.PlayerRemoving:Connect(function(player)

	removeESP(player)

	if CurrentTarget == player then
		CurrentTarget = nil
	end
end)

--========================================================
-- ESP UPDATE
--========================================================

RunService.RenderStepped:Connect(function()

	for player, data in pairs(ESPObjects) do

		local character =
			player.Character

		if not character then

			if data.Highlight then
				data.Highlight.Enabled = false
			end

			if data.Billboard then
				data.Billboard.Enabled = false
			end

		else

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			if humanoid
				and humanoid.Health > 0
				and root then

				if data.Highlight then

					data.Highlight.Adornee =
						character

					data.Highlight.Enabled =
						Config.ESP

					data.Highlight.DepthMode =
						Config.ESPThroughWalls
						and Enum.HighlightDepthMode.AlwaysOnTop
						or Enum.HighlightDepthMode.Occluded
				end

				if data.Billboard then

					data.Billboard.Adornee =
						root

					data.Billboard.Enabled =
						Config.ESP
						and Config.ShowInfo

					if data.Label then

						local myCharacter =
							LocalPlayer.Character

						local myRoot =
							myCharacter
							and myCharacter:FindFirstChild(
								"HumanoidRootPart"
							)

						if myRoot then

							local distance =
								(
									myRoot.Position
									- root.Position
								).Magnitude

							data.Label.Text =
								player.Name
								.. " | "
								.. math.floor(distance)
								.. "m"

						else

							data.Label.Text =
								player.Name
						end
					end
				end

			else

				if data.Highlight then
					data.Highlight.Enabled = false
				end

				if data.Billboard then
					data.Billboard.Enabled = false
				end
			end
		end
	end
end)

--========================================================
-- AIMBOT HELPERS
--========================================================

local function validTarget(player)

	if not player
		or player == LocalPlayer then
		return false
	end

	local character =
		player.Character

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid
		or humanoid.Health <= 0 then
		return false
	end

	local target =
		character:FindFirstChild(
			Config.AimPart
		)

	if not target
		or not target:IsA("BasePart") then
		return false
	end

	return true
end

local function getAimPart(player)

	if not validTarget(player) then
		return nil
	end

	local character =
		player.Character

	local head =
		character:FindFirstChild(
			Config.AimPart
		)

	if head and head:IsA("BasePart") then
		return head
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if root then
		return root
	end

	return nil
end

--========================================================
-- WALL CHECK
--========================================================

local function isVisible(player)

	if not validTarget(player) then
		return false
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return false
	end

	local character =
		player.Character

	local target =
		getAimPart(player)

	if not character or not target then
		return false
	end

	if not Config.WallCheck then
		return true
	end

	local origin =
		camera.CFrame.Position

	local direction =
		target.Position - origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}

	params.IgnoreWater = true

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	-- Чистая линия
	if not result then
		return true
	end

	-- Первое попадание — сам игрок
	if result.Instance:IsDescendantOf(
		character
	) then
		return true
	end

	-- Между нами и игроком есть стена
	return false
end

--========================================================
-- FIND TARGET
--========================================================

local function findTarget()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return nil
	end

	local viewport =
		camera.ViewportSize

	local center =
		Vector2.new(
			viewport.X / 2,
			viewport.Y / 2
		)

	local bestPlayer = nil
	local bestDistance = Config.FOV

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if validTarget(player) then

			local target =
				getAimPart(player)

			if target then

				local position, onScreen =
					camera:WorldToViewportPoint(
						target.Position
					)

				if onScreen
					and position.Z > 0 then

					local point =
						Vector2.new(
							position.X,
							position.Y
						)

					local distance =
						(point - center).Magnitude

					if distance <= bestDistance then

						if isVisible(player) then

							bestDistance =
								distance

							bestPlayer =
								player
						end
					end
				end
			end
		end
	end

	return bestPlayer
end

--========================================================
-- AIM
--========================================================

local function aimAt(player)

	if not validTarget(player) then
		return false
	end

	-- За стеной
	if not isVisible(player) then
		return false
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return false
	end

	local target =
		getAimPart(player)

	if not target then
		return false
	end

	-- АКТУАЛЬНАЯ позиция головы
	local targetPosition =
		target.Position

	local cameraPosition =
		camera.CFrame.Position

	local desired =
		CFrame.lookAt(
			cameraPosition,
			targetPosition,
			Vector3.new(0, 1, 0)
		)

	if Config.Smoothness >= 1 then

		-- Абсолютно точное наведение
		camera.CFrame = desired

	else

		camera.CFrame =
			camera.CFrame:Lerp(
				desired,
				Config.Smoothness
			)
	end

	return true
end

--========================================================
-- STABLE AIMBOT
--========================================================

RunService:BindToRenderStep(
	"JimboJjos_Aimbot_V2",

	-- Очень высокий приоритет:
	-- позволяет удерживать направление даже если
	-- стандартная камера обновляется мышью/ПКМ
	100000,

	function()

		if not Config.Aimbot then

			CurrentTarget = nil
			TargetLabel.Text =
				"Target: None"

			return
		end

		--================================================
		-- УЖЕ ЗАХВАЧЕНА
		--================================================

		if CurrentTarget then

			if validTarget(CurrentTarget)
				and isVisible(CurrentTarget) then

				-- ВАЖНО:
				-- FOV здесь НЕ проверяется.
				-- Захват остаётся даже вне круга.
				aimAt(CurrentTarget)

				TargetLabel.Text =
					"Target: "
					.. CurrentTarget.Name

				return
			end

			-- Игрок умер / исчез / за стеной
			CurrentTarget = nil

			TargetLabel.Text =
				"Target: None"
		end

		--================================================
		-- НОВЫЙ ЗАХВАТ
		--================================================

		local target =
			findTarget()

		if target then

			CurrentTarget =
				target

			TargetLabel.Text =
				"Target: "
				.. target.Name

			aimAt(CurrentTarget)
		end
	end
)

