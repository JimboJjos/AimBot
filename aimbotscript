--========================================================
-- JimboJjos | STABLE AIMBOT
--========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local AimbotConfig = {
	Enabled = true,

	-- Радиус круга для ПЕРВИЧНОГО захвата цели
	FOV = 150,

	-- Часть персонажа, в которую целимся
	TargetPart = "Head",

	-- 1 = максимально точное наведение
	Smoothness = 1,

	-- Проверка стен
	WallCheck = true,

	-- Не переключаться на другого игрока,
	-- пока текущая цель ещё валидна
	StickyTarget = true
}

local CurrentTarget = nil

--========================================================
-- САМАЯ АКТУАЛЬНАЯ КАМЕРА
--========================================================

local function getCamera()
	return workspace.CurrentCamera
end

--========================================================
-- ПРОВЕРКА ЖИЗНИ ЦЕЛИ
--========================================================

local function isAlive(player)
	if not player or player == LocalPlayer then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local targetPart = character:FindFirstChild(AimbotConfig.TargetPart)
	if not targetPart or not targetPart:IsA("BasePart") then
		return false
	end

	return true
end

--========================================================
-- WALL CHECK
--========================================================

local function canSee(player)
	if not isAlive(player) then
		return false
	end

	if not AimbotConfig.WallCheck then
		return true
	end

	local camera = getCamera()
	local character = player.Character
	local targetPart = character:FindFirstChild(AimbotConfig.TargetPart)

	if not camera or not targetPart then
		return false
	end

	local origin = camera.CFrame.Position
	local direction = targetPart.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}
	params.IgnoreWater = true

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	-- Ничего не встретили
	if not result then
		return true
	end

	-- Луч попал непосредственно в персонажа
	if result.Instance:IsDescendantOf(character) then
		return true
	end

	-- Между камерой и целью есть препятствие
	return false
end

--========================================================
-- ПОИСК ЦЕЛИ ВНУТРИ FOV
--========================================================

local function findTarget()
	if not AimbotConfig.Enabled then
		return nil
	end

	local camera = getCamera()

	if not camera then
		return nil
	end

	local viewport = camera.ViewportSize

	local screenCenter = Vector2.new(
		viewport.X / 2,
		viewport.Y / 2
	)

	local closestPlayer = nil
	local closestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer and isAlive(player) then

			local character = player.Character
			local targetPart =
				character:FindFirstChild(AimbotConfig.TargetPart)

			if targetPart then

				local screenPosition, onScreen =
					camera:WorldToViewportPoint(
						targetPart.Position
					)

				if onScreen and screenPosition.Z > 0 then

					local point = Vector2.new(
						screenPosition.X,
						screenPosition.Y
					)

					local distance =
						(point - screenCenter).Magnitude

					-- Только для первичного захвата
					if distance <= AimbotConfig.FOV
						and distance < closestDistance then

						if canSee(player) then
							closestDistance = distance
							closestPlayer = player
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

--========================================================
-- ТОЧНОЕ НАВЕДЕНИЕ
--========================================================

local function aimAt(player)

	if not isAlive(player) then
		return false
	end

	-- Цель за стеной -> немедленно отпускаем
	if not canSee(player) then
		return false
	end

	local camera = getCamera()
	local character = player.Character

	if not camera or not character then
		return false
	end

	local targetPart =
		character:FindFirstChild(AimbotConfig.TargetPart)

	if not targetPart then
		return false
	end

	local cameraPosition = camera.CFrame.Position

	-- Точная позиция цели прямо сейчас
	local targetPosition = targetPart.Position

	local newCFrame = CFrame.lookAt(
		cameraPosition,
		targetPosition
	)

	if AimbotConfig.Smoothness >= 1 then

		-- Абсолютно точное наведение
		camera.CFrame = newCFrame

	else

		-- Плавное наведение
		camera.CFrame =
			camera.CFrame:Lerp(
				newCFrame,
				AimbotConfig.Smoothness
			)
	end

	return true
end

--========================================================
-- AIMBOT
--========================================================

pcall(function()
	RunService:UnbindFromRenderStep(
		"JimboJjos_StableAimbot"
	)
end)

RunService:BindToRenderStep(
	"JimboJjos_StableAimbot",
	1000,
	function()

		if not AimbotConfig.Enabled then
			CurrentTarget = nil
			return
		end

		----------------------------------------------------
		-- УЖЕ ЕСТЬ ЦЕЛЬ
		----------------------------------------------------

		if CurrentTarget then

			-- Продолжаем держать именно её.
			-- FOV после захвата НЕ проверяется.
			local success = aimAt(CurrentTarget)

			if success then
				return
			end

			-- Цель умерла / вышла из игры / за стеной
			CurrentTarget = nil
		end

		----------------------------------------------------
		-- НОВЫЙ ЗАХВАТ
		----------------------------------------------------

		local newTarget = findTarget()

		if newTarget then
			CurrentTarget = newTarget

			-- Сразу делаем первый точный поворот
			aimAt(CurrentTarget)
		end
	end
)

--========================================================
-- ОБРАБОТКА ИГРОКОВ
--========================================================

Players.PlayerRemoving:Connect(function(player)
	if CurrentTarget == player then
		CurrentTarget = nil
	end
end)
