local ESPObjects = {}

local function removeESP(player)

    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    if data.Connection then
        data.Connection:Disconnect()
    end

    ESPObjects[player] = nil
end

local function createCharacterESP(player, character)

    local data = ESPObjects[player]

    if not data then
        return
    end

    -- Удаляем старый ESP
    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid then
        humanoid =
            character:WaitForChild("Humanoid", 5)
    end

    if not root then
        root =
            character:WaitForChild(
                "HumanoidRootPart",
                5
            )
    end

    if not humanoid or not root then
        return
    end

    --====================================================
    -- FULL BODY HIGHLIGHT
    --====================================================

    local highlight = Instance.new("Highlight")

    highlight.Name = "FullBodyESP"

    -- ВСЯ модель
    highlight.Adornee = character

    highlight.FillColor =
        Color3.fromRGB(255, 60, 60)

    highlight.FillTransparency = 0.30

    highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    highlight.OutlineTransparency = 0

    highlight.DepthMode =
        Config.ESPThroughWalls
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded

    highlight.Enabled = Config.ESP

    -- ВАЖНО: Highlight находится в Workspace
    highlight.Parent = ESPFolder

    --====================================================
    -- NAME + DISTANCE
    --====================================================

    local billboard = Instance.new("BillboardGui")

    billboard.Name = "PlayerInfo"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(220, 40)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = Config.ESP
    billboard.Parent = PlayerGui

    local label = Instance.new("TextLabel")

    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    label.TextStrokeTransparency = 0
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.Text = player.Name
    label.Parent = billboard

    data.Character = character
    data.Highlight = highlight
    data.Billboard = billboard
    data.Label = label
end

local function setupESP(player)

    if player == LocalPlayer then
        return
    end

    removeESP(player)

    local data = {
        Character = nil,
        Highlight = nil,
        Billboard = nil,
        Label = nil,
        Connection = nil
    }

    ESPObjects[player] = data

    data.Connection =
        player.CharacterAdded:Connect(
            function(character)

                task.wait(0.1)

                if ESPObjects[player] then
                    createCharacterESP(
                        player,
                        character
                    )
                end
            end
        )

    if player.Character then
        task.spawn(function()

            createCharacterESP(
                player,
                player.Character
            )
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupESP(player)
end

Players.PlayerAdded:Connect(function(player)
    setupESP(player)
end)

Players.PlayerRemoving:Connect(function(player)

