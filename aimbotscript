local function updateFOV(value)

	Settings.FOV = math.clamp(
		math.floor(value + 0.5),
		Settings.MinFOV,
		Settings.MaxFOV
	)

	local percent =
		(Settings.FOV - Settings.MinFOV)
		/ (Settings.MaxFOV - Settings.MinFOV)

	Fill.Size = UDim2.new(percent, 0, 1, 0)
	Knob.Position = UDim2.new(percent, 0, 0.5, 0)

	FOVLabel.Text =
		"FOV Size: " .. Settings.FOV

	FOVCircle.Size =
		UDim2.fromOffset(
			Settings.FOV * 2,
			Settings.FOV * 2
		)
end

local function moveSlider(x)

	local left = Slider.AbsolutePosition.X
	local width = Slider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local percent =
		math.clamp(
			(x - left) / width,
			0,
			1
		)

	local value =
		Settings.MinFOV
		+ (Settings.MaxFOV - Settings.MinFOV)
		* percent

	updateFOV(value)
end

