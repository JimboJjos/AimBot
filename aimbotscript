--========================================================
-- JimboJjos | ESP + AIMBOT
--========================================================

local CurrentTarget = nil

local AimbotConfig = {
	Enabled = true,

	-- Радиус первичного захвата
	FOV = 150,

	-- Точка наведения
	TargetPart = "Head",

	-- 1 = моментально
	-- 0.15 = плавно
	Smoothness = 1,

	-- Проверять стены
	WallCheck = true
}

--========================================================
-- PLAYER VALIDATION
--========================================================

local function isValidTarget(player)
	if not player or player == LocalPlayer then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local target = character:FindFirstChild(AimbotConfig.TargetPart)

	if not target or not target:IsA("BasePart") then
		return false
	end

	return true
end

--========================================================
-- TARGET PART
--========================================================

local function getTargetPart(player)
	if not isValidTarget(player) then
		return nil
	end

	local character = player.Character

	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end

	local upperTorso = character:FindFirstChild("UpperTorso")
	if upperTorso and upperTorso:IsA("BasePart") then
		return upperTorso
	end

	local torso = character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end

	return nil
end

--========================================================
-- WALL CHECK
--========================================================

local function hasLineOfSight(player)
	if not isValidTarget(player) then
		return false
	end

	if not AimbotConfig.WallCheck then
		return true
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	local character = player.Character
	local target = getTargetPart(player)

	if not character or not target then
		return false
	end

	local origin = camera.CFrame.Position
	local direction = target.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}
	params.IgnoreWater = true

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(character)
end

--========================================================
-- FIND TARGET
--========================================================

local function findTarget()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	local viewport = camera.ViewportSize

	local center = Vector2.new(
		viewport.X * 0.5,
		viewport.Y * 0.5
	)

	local bestPlayer = nil
	local bestDistance = AimbotConfig.FOV

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer and isValidTarget(player) then

			local target = getTargetPart(player)

			if target then

				local screenPosition, visible =
					camera:WorldToViewportPoint(
						target.Position
					)

				if visible and screenPosition.Z > 0 then

					local screenPoint = Vector2.new(
						screenPosition.X,
						screenPosition.Y
					)

					local distance =
						(screenPoint - center).Magnitude

					if distance < bestDistance then

						if hasLineOfSight(player) then

							bestDistance = distance
							bestPlayer = player

						end
					end
				end
			end
		end
	end

	return bestPlayer
end

--========================================================
-- AIM
--========================================================

local function aimAt(player)
	if not isValidTarget(player) then
		return false
	end

	if not hasLineOfSight(player) then
		return false
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	local target = getTargetPart(player)
	if not target then
		return false
	end

	local cameraPosition = camera.CFrame.Position

	-- Сохраняем текущий UpVector камеры,
	-- поэтому оружие не получает неожиданный roll.
	local desiredCFrame = CFrame.lookAt(
		cameraPosition,
		target.Position,
		camera.CFrame.UpVector
	)

	if AimbotConfig.Smoothness >= 1 then

		camera.CFrame = desiredCFrame

	else

		camera.CFrame = camera.CFrame:Lerp(
			desiredCFrame,
			AimbotConfig.Smoothness
		)
	end

	return true
end

--========================================================
-- CLEAN PREVIOUS CONNECTION
--========================================================

pcall(function()
	RunService:UnbindFromRenderStep(
		"JimboJjosStableAimbot"
	)
end)

--========================================================
-- MAIN LOOP
--========================================================
--
-- ВАЖНО:
-- Не 10000.
-- Камера игры обновляется первой,
-- затем наш aim,
-- затем остальные визуальные элементы.
--
-- Это предотвращает рассинхрон оружия и камеры.
--========================================================

RunService:BindToRenderStep(
	"JimboJjosStableAimbot",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not AimbotConfig.Enabled then
			CurrentTarget = nil

			if TargetLabel then
				TargetLabel.Text = "Target: None"
			end

			return
		end

		--================================================
		-- УДЕРЖАНИЕ ТЕКУЩЕЙ ЦЕЛИ
		--================================================

		if CurrentTarget then

			local valid =
				isValidTarget(CurrentTarget)

			local visible =
				valid
				and hasLineOfSight(CurrentTarget)

			if valid and visible then

				-- FOV здесь НЕ проверяется.
				-- Цель удерживается вне круга.
				aimAt(CurrentTarget)

				if TargetLabel then
					TargetLabel.Text =
						"Target: "
						.. CurrentTarget.Name
				end

				return
			end

			-- Стена / смерть / исчезновение
			CurrentTarget = nil

			if TargetLabel then
				TargetLabel.Text = "Target: None"
			end
		end

		--================================================
		-- НОВЫЙ ЗАХВАТ
		--================================================

		local target = findTarget()

		if target then

			CurrentTarget = target

			if TargetLabel then
				TargetLabel.Text =
					"Target: "
					.. target.Name
			end

			aimAt(CurrentTarget)
		end
	end
)
