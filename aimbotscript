local function destroyESP(player)

    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    if data.Connection then
        data.Connection:Disconnect()
    end

    ESPObjects[player] = nil
end

local function createESP(player, character)

    if player == LocalPlayer then
        return
    end

    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    -- Полная модель
    local highlight = Instance.new("Highlight")

    highlight.Name = "JimboJjosESP"

    highlight.Adornee = character

    highlight.FillColor =
        Color3.fromRGB(255, 55, 55)

    highlight.FillTransparency = 0.2

    highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    highlight.OutlineTransparency = 0

    highlight.DepthMode =
        Settings
        and Settings.ESPThroughWalls
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded

    highlight.Enabled = Config.ESP
    highlight.Parent = character

    data.Character = character
    data.Highlight = highlight

    -- Информация
    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if root then

        local billboard =
            Instance.new("BillboardGui")

        billboard.Name =
            "JimboJjosInfo"

        billboard.Adornee =
            root

        billboard.Size =
            UDim2.fromOffset(220, 40)

        billboard.StudsOffset =
            Vector3.new(0, 3.5, 0)

        billboard.AlwaysOnTop =
            true

        billboard.Enabled =
            Config.ESP

        billboard.Parent =
            Gui

        local label =
            Instance.new("TextLabel")

        label.Size =
            UDim2.fromScale(1, 1)

        label.BackgroundTransparency =
            1

        label.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        label.TextStrokeTransparency =
            0

        label.TextSize = 12
        label.Font = Enum.Font.GothamBold

        label.Text =
            player.Name

        label.Parent =
            billboard

        data.Billboard = billboard
        data.Label = label
    end
end

local function setupESP(player)

    if player == LocalPlayer then
        return
    end

    destroyESP(player)

    ESPObjects[player] = {
        Connection = nil,
        Character = nil,
        Highlight = nil,
        Billboard = nil,
        Label = nil
    }

    ESPObjects[player].Connection =
        player.CharacterAdded:Connect(
            function(character)

                task.wait(0.05)

                if ESPObjects[player] then
                    createESP(
                        player,
                        character
                    )
                end
            end
        )

    if player.Character then

        task.spawn(function()

            createESP(
                player,
                player.Character
            )
        end)
    end
end

for _, player in ipairs(
    Players:GetPlayers()
) do
    setupESP(player)
end

Players.PlayerAdded:Connect(setupESP)

Players.PlayerRemoving:Connect(function(player)

    destroyESP(player)

    if CurrentTarget == player then
        CurrentTarget = nil
    end
end)

--========================================================
-- ESP UPDATE
--========================================================

RunService.RenderStepped:Connect(function()

    for player, data in pairs(ESPObjects) do

        local character =
            player.Character

        if not character then
            continue
        end

        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not humanoid
            or humanoid.Health <= 0 then

            if data.Highlight then
                data.Highlight.Enabled =
                    false
            end

            if data.Billboard then
                data.Billboard.Enabled =
                    false
            end

            continue
        end

        if data.Highlight then

            data.Highlight.Adornee =
                character

            data.Highlight.Enabled =
                Config.ESP

            data.Highlight.DepthMode =
                Config.ESPThroughWalls
                and Enum.HighlightDepthMode.AlwaysOnTop
                or Enum.HighlightDepthMode.Occluded
        end

        local root =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if data.Billboard and root then

            data.Billboard.Adornee =
                root

            data.Billboard.Enabled =
                Config.ESP

            local myCharacter =
                LocalPlayer.Character

            local myRoot =
                myCharacter
                and myCharacter:FindFirstChild(
                    "HumanoidRootPart"
                )

            if myRoot and data.Label then

                local distance =
                    (
                        myRoot.Position
                        - root.Position
                    ).Magnitude

                data.Label.Text =
                    player.Name
                    .. " | "
                    .. math.floor(distance)
                    .. "m"
            end
        end
    end
end)

--========================================================
-- AIMBOT
--========================================================

local function getAimPart(player)

    if not player
        or player == LocalPlayer then
        return nil
    end

    local character =
        player.Character

    if not character then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid
        or humanoid.Health <= 0 then
        return nil
    end

    -- Приоритетная точка
    local head =
        character:FindFirstChild("Head")

    if head and head:IsA("BasePart") then
        return head
    end

    -- Fallback для другого рига
    for _, name in ipairs({
        "UpperTorso",
        "Torso",
        "HumanoidRootPart"
    }) do

        local part =
            character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

local function visible(player)

    if not player then
        return false
    end

    local camera =
        workspace.CurrentCamera

    if not camera then
        return false
    end

    local character =
        player.Character

    local target =
        getAimPart(player)

    if not character or not target then
        return false
    end

    if not Config.WallCheck then
        return true
    end

    local origin =
        camera.CFrame.Position

    local direction =
        target.Position - origin

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        LocalPlayer.Character
    }

    params.IgnoreWater = true

    local result =
        workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(
        character
    )
end

local function findTarget()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local viewport =
        camera.ViewportSize

    local center =
        Vector2.new(
            viewport.X * 0.5,
            viewport.Y * 0.5
        )

    local closestPlayer =
        nil

    local closestDistance =
        Config.FOV

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        local target =
            getAimPart(player)

        if target then

            local screen,
                onScreen =
                camera:WorldToViewportPoint(
                    target.Position
                )

            if onScreen
                and screen.Z > 0 then

                local point =
                    Vector2.new(
                        screen.X,
                        screen.Y
                    )

                local distance =
                    (
                        point - center
                    ).Magnitude

                if distance <=
                    closestDistance then

                    if visible(player) then

                        closestDistance =
                            distance

                        closestPlayer =
                            player
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function aimAt(player)

    local camera =
        workspace.CurrentCamera

    if not camera then
        return false
    end

    local target =
        getAimPart(player)

    if not target then
        return false
    end

    if not visible(player) then
        return false
    end

    local cameraPosition =
        camera.CFrame.Position

    local desired =
        CFrame.lookAt(
            cameraPosition,
            target.Position,
            camera.CFrame.UpVector
        )

    if Config.Smoothness >= 1 then

        camera.CFrame =
            desired

    else

        camera.CFrame =
            camera.CFrame:Lerp(
                desired,
                Config.Smoothness
            )
    end

    return true
end

--========================================================
-- AIM LOOP
--========================================================

pcall(function()

    RunService:UnbindFromRenderStep(
        "JimboJjos_Aim"
    )
end)

RunService:BindToRenderStep(
    "JimboJjos_Aim",

    Enum.RenderPriority.Camera.Value + 1,

    function()

        if not Config.Aimbot then

            CurrentTarget = nil

            TargetLabel.Text =
                "Target: None"

            return
        end

        --================================================
        -- HOLD CURRENT TARGET
        --================================================

        if CurrentTarget then

            if getAimPart(CurrentTarget)
                and visible(CurrentTarget) then

                -- После захвата FOV НЕ проверяется.
                aimAt(CurrentTarget)

                TargetLabel.Text =
                    "Target: "
                    .. CurrentTarget.Name

                return
            end

            -- Стена / смерть / исчезновение
            CurrentTarget = nil

            TargetLabel.Text =
                "Target: None"
        end

        --================================================
        -- NEW TARGET
        --================================================

        local target =
            findTarget()

        if target then

            CurrentTarget =
                target

            TargetLabel.Text =
                "Target: "
                .. target.Name

            aimAt(CurrentTarget)
        end
    end
)

