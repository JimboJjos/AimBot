-- STABLE AIMBOT
--========================================================

pcall(function()
    RunService:UnbindFromRenderStep(
        "JimboJjosAimbot"
    )
end)

RunService:BindToRenderStep(
    "JimboJjosAimbot",

    -- Выполняется после стандартной камеры
    10000,

    function()

        if not Config.Aimbot then

            CurrentTarget = nil
            TargetLabel.Text =
                "Target: None"

            return
        end

        --================================================
        -- ДЕРЖИМ ТЕКУЩУЮ ЦЕЛЬ
        --================================================

        if CurrentTarget then

            if validTarget(CurrentTarget)
                and visible(CurrentTarget) then

                -- FOV здесь НЕ проверяем
                -- Цель удерживается вне круга
                aimAt(CurrentTarget)

                TargetLabel.Text =
                    "Target: "
                    .. CurrentTarget.Name

                return
            end

            -- Смерть / стена / исчезновение
            CurrentTarget = nil

            TargetLabel.Text =
                "Target: None"
        end

        --================================================
        -- НОВЫЙ ЗАХВАТ
        --================================================

        local newTarget =
            findTarget()

        if newTarget then

            CurrentTarget =
                newTarget

            TargetLabel.Text =
                "Target: "
                .. newTarget.Name

            -- Первый кадр сразу точно на цель
            aimAt(CurrentTarget)
        end
    end
)

