-- MAIN LOOP
--========================================================

RunService.RenderStepped:Connect(function()

	-- ESP
	for player, data in pairs(espData) do
		updateESP(player, data)
	end

	-- FOV
	fovCircle.Visible = AIMBOT_ENABLED

	-- AIMBOT
	if AIMBOT_ENABLED then
		local target = getTarget()

		if target then
			aimAt(target)
		end
	end
end)

