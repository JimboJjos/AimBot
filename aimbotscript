local ESP = {}

local function destroyESP(player)

    local data = ESP[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    if data.CharacterConnection then
        data.CharacterConnection:Disconnect()
    end

    ESP[player] = nil
end

local function createCharacterESP(player, character)

    local data = ESP[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid then
        humanoid =
            character:WaitForChild(
                "Humanoid",
                5
            )
    end

    if not root then
        root =
            character:WaitForChild(
                "HumanoidRootPart",
                5
            )
    end

    if not humanoid or not root then
        return
    end

    --====================================================
    -- ПОЛНАЯ ПОДСВЕТКА МОДЕЛИ
    --====================================================

    local Highlight = Instance.new("Highlight")

    Highlight.Name = "JimboJjosFullESP"

    -- Adornee = ВСЯ модель персонажа
    Highlight.Adornee = character

    Highlight.FillColor =
        Color3.fromRGB(255, 60, 60)

    Highlight.FillTransparency = 0.35

    Highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    Highlight.OutlineTransparency = 0

    Highlight.DepthMode =
        Config.ESPThroughWalls
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded

    Highlight.Enabled = Config.ESP

    Highlight.Parent = Gui

    --====================================================
    -- NAME / DISTANCE
    --====================================================

    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = "JimboJjosPlayerInfo"
    Billboard.Adornee = root
    Billboard.Size = UDim2.fromOffset(220, 42)
    Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Enabled = Config.ESP
    Billboard.Parent = Gui

    local Label = Instance.new("TextLabel")

    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextStrokeTransparency = 0
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamBold
    Label.Text = player.Name
    Label.Parent = Billboard

    data.Character = character
    data.Highlight = Highlight
    data.Billboard = Billboard
    data.Label = Label
end

local function setupESP(player)

    if player == LocalPlayer then
        return
    end

    destroyESP(player)

    local data = {
        Character = nil,
        Highlight = nil,
        Billboard = nil,
        Label = nil,
        CharacterConnection = nil
    }

    ESP[player] = data

    -- Респавн
    data.CharacterConnection =
        player.CharacterAdded:Connect(function(character)

            task.wait(0.15)

            if ESP[player] then
                createCharacterESP(
                    player,
                    character
                )
            end
        end)

    -- Уже существует
    if player.Character then
        task.spawn(function()
            createCharacterESP(
                player,
                player.Character
            )
        end)
    end
end

