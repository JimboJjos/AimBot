local SliderDragging = false

local function updateFOV(value)

	Config.FOV = math.clamp(
		math.floor(value + 0.5),
		Config.MinFOV,
		Config.MaxFOV
	)

	local percent =
		(Config.FOV - Config.MinFOV) /
		(Config.MaxFOV - Config.MinFOV)

	Fill.Size =
		UDim2.new(
			percent,
			0,
			1,
			0
		)

	Knob.Position =
		UDim2.new(
			percent,
			0,
			0.5,
			0
		)

	FOVLabel.Text =
		"FOV Size: " .. Config.FOV

	FOVCircle.Size =
		UDim2.fromOffset(
			Config.FOV * 2,
			Config.FOV * 2
		)
end

local function setSlider(x)

	local startX =
		Slider.AbsolutePosition.X

	local width =
		Slider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local percent =
		math.clamp(
			(x - startX) / width,
			0,
			1
		)

	local value =
		Config.MinFOV +
		(Config.MaxFOV - Config.MinFOV)
		* percent

	updateFOV(value)
end

Slider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SliderDragging = true
		setSlider(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not SliderDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		setSlider(input.Position.X)
	end
end)

