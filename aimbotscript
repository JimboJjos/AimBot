-- ESP
--========================================================

local function destroyESP(player)

	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end

	if data.Connection then
		data.Connection:Disconnect()
	end

	ESPObjects[player] = nil
end

local function createESP(player, character)

	if not character then
		return
	end

	local data = ESPObjects[player]

	if not data then
		return
	end

	-- Удаляем старый ESP
	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid then
		humanoid =
			character:WaitForChild(
				"Humanoid",
				5
			)
	end

	if not root then
		root =
			character:WaitForChild(
				"HumanoidRootPart",
				5
			)
	end

	if not humanoid or not root then
		return
	end

	--====================================================
	-- FULL BODY HIGHLIGHT
	--====================================================

	local highlight = Instance.new("Highlight")
	highlight.Name = "JimboJjosESP"
	highlight.Adornee = character
	highlight.FillColor = Color3.fromRGB(255, 55, 55)
	highlight.FillTransparency = 0.25
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0

	if Settings.ESPThroughWalls then
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
	else
		highlight.DepthMode =
			Enum.HighlightDepthMode.Occluded
	end

	highlight.Enabled = Settings.ESP
	highlight.Parent = character

	--====================================================
	-- NAME / DISTANCE
	--====================================================

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "JimboJjosESPInfo"
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(220, 40)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = Settings.ESP
	billboard.Parent = PlayerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextSize = 12
	label.Font = Enum.Font.GothamBold
	label.Text = player.Name
	label.Parent = billboard

	data.Character = character
	data.Highlight = highlight
	data.Billboard = billboard
	data.Label = label
end

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	destroyESP(player)

	local data = {
		Connection = nil,
		Character = nil,
		Highlight = nil,
		Billboard = nil,
		Label = nil
	}

	ESPObjects[player] = data

	data.Connection =
		player.CharacterAdded:Connect(
			function(character)

				task.wait(0.1)

				if ESPObjects[player] then
					createESP(
						player,
						character
					)
				end
			end
		)

	if player.Character then
		task.spawn(function()
			createESP(
				player,
				player.Character
			)
		end)
	end
end

for _, player in ipairs(
	Players:GetPlayers()
) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)

	destroyESP(player)

	if CurrentTarget == player then
		CurrentTarget = nil
	end
end)

--========================================================
-- ESP UPDATE
--========================================================

RunService.RenderStepped:Connect(function()

	for player, data in pairs(ESPObjects) do

		local character = player.Character

		if not character then
			if data.Highlight then
				data.Highlight.Enabled = false
			end

			if data.Billboard then
				data.Billboard.Enabled = false
			end

			continue
		end

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		local root =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not humanoid
			or humanoid.Health <= 0
			or not root then

			if data.Highlight then
				data.Highlight.Enabled = false
			end

			if data.Billboard then
				data.Billboard.Enabled = false
			end

			continue
		end

		-- Полная модель
		if data.Highlight then

			data.Highlight.Adornee =
				character

			data.Highlight.Enabled =
				Settings.ESP

			data.Highlight.DepthMode =
				Settings.ESPThroughWalls
				and Enum.HighlightDepthMode.AlwaysOnTop
				or Enum.HighlightDepthMode.Occluded
		end

		if data.Billboard then

			data.Billboard.Adornee =
				root

			data.Billboard.Enabled =
				Settings.ESP

			if data.Label then

				local myCharacter =
					LocalPlayer.Character

				local myRoot =
					myCharacter
					and myCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if myRoot then

					local distance =
						(
							myRoot.Position
							- root.Position
						).Magnitude

					data.Label.Text =
						player.Name
						.. " | "
						.. math.floor(distance)
						.. "m"
				else
					data.Label.Text =
						player.Name
				end
			end
		end
	end
end)

--========================================================
-- AIMBOT
--========================================================

local function validTarget(player)

	if not player
		or player == LocalPlayer then
		return false
	end

	local character =
		player.Character

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid
		or humanoid.Health <= 0 then
		return false
	end

	local target =
		character:FindFirstChild(
			Settings.TargetPart
		)

	return target ~= nil
		and target:IsA("BasePart")
end

local function getAimPart(player)

	if not validTarget(player) then
		return nil
	end

	local character =
		player.Character

	return character:FindFirstChild(
		Settings.TargetPart
	)
end

--========================================================
-- WALL CHECK
--========================================================

local function canSee(player)

	if not validTarget(player) then
		return false
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return false
	end

	local character =
		player.Character

	local target =
		getAimPart(player)

	if not character or not target then
		return false
	end

	if not Settings.WallCheck then
		return true
	end

	local origin =
		camera.CFrame.Position

	local direction =
		target.Position - origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}

	params.IgnoreWater = true

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(
		character
	)
end

--========================================================
-- FIND TARGET
--========================================================

local function findTarget()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return nil
	end

	local viewport =
		camera.ViewportSize

	local center =
		Vector2.new(
			viewport.X / 2,
			viewport.Y / 2
		)

	local bestPlayer = nil
	local bestDistance = Settings.FOV

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if validTarget(player) then

			local target =
				getAimPart(player)

			local position, onScreen =
				camera:WorldToViewportPoint(
					target.Position
				)

			if onScreen
				and position.Z > 0 then

				local point =
					Vector2.new(
						position.X,
						position.Y
					)

				local distance =
					(point - center).Magnitude

				if distance <= bestDistance
					and canSee(player) then

					bestDistance =
						distance

					bestPlayer =
						player
				end
			end
		end
	end

	return bestPlayer
end

--========================================================
-- AIM
--========================================================

local function aimAt(player)

	if not validTarget(player) then
		return false
	end

	if not canSee(player) then
		return false
	end

	local camera =
		workspace.CurrentCamera

	local target =
		getAimPart(player)

	if not camera or not target then
		return false
	end

	local desired =
		CFrame.lookAt(
			camera.CFrame.Position,
			target.Position,
			Vector3.new(0, 1, 0)
		)

	if Settings.Smoothness >= 1 then
		camera.CFrame = desired
	else
		camera.CFrame =
			camera.CFrame:Lerp(
				desired,
				Settings.Smoothness
			)
	end

	return true
end

--========================================================
-- STABLE AIM LOOP
--========================================================

pcall(function()
	RunService:UnbindFromRenderStep(
		"JimboJjosAimbot"
	)
end)

RunService:BindToRenderStep(
	"JimboJjosAimbot",
	10000,
	function()

		if not Settings.Aimbot then

			CurrentTarget = nil
			TargetLabel.Text =
				"Target: None"

			return
		end

		-- Текущая цель
		if CurrentTarget then

			if validTarget(CurrentTarget)
				and canSee(CurrentTarget) then

				-- FOV больше НЕ проверяется
				-- после захвата
				if aimAt(CurrentTarget) then

					TargetLabel.Text =
						"Target: "
						.. CurrentTarget.Name

					return
				end
			end

			-- Смерть / стена
			CurrentTarget = nil
		end

		-- Новая цель
		local target =
			findTarget()

		if target then

			CurrentTarget =
				target

			TargetLabel.Text =
				"Target: "
				.. target.Name

			aimAt(CurrentTarget)
		end
	end
)

