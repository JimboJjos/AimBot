--========================================================
-- JimboJjos | ESP + AIM
--========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ESPEnabled = true
local AimbotEnabled = true

local FOV = 500
local MIN_FOV = 50
local MAX_FOV = 500

local AIM_PART_NAME = "Head"
local CURRENT_TARGET = nil

local ESP = {}

--========================================================
-- TARGET PART
--========================================================

local function getAimPart(player)
    local character = player and player.Character
    if not character then
        return nil
    end

    -- Для R15
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end

    -- Для нестандартных/старых ригов
    for _, name in ipairs({
        "UpperTorso",
        "Torso",
        "HumanoidRootPart"
    }) do
        local part = character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

--========================================================
-- ALIVE CHECK
--========================================================

local function isAlive(player)
    if not player or player == LocalPlayer then
        return false
    end

    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    return getAimPart(player) ~= nil
end

--========================================================
-- ESP CLEAN
--========================================================

local function cleanupESP(player)
    local data = ESP[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Info then
        data.Info:Destroy()
        data.Info = nil
    end
end

--========================================================
-- CREATE ESP
--========================================================

local function createESP(player, character)
    if player == LocalPlayer then
        return
    end

    local data = ESP[player]

    if not data then
        return
    end

    cleanupESP(player)

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        humanoid =
            character:WaitForChild("Humanoid", 5)
    end

    if not humanoid then
        return
    end

    --====================================================
    -- FULL BODY HIGHLIGHT
    --====================================================

    local highlight = Instance.new("Highlight")

    highlight.Name = "JimboJjosESP"
    highlight.Adornee = character

    highlight.FillColor =
        Color3.fromRGB(255, 55, 55)

    highlight.FillTransparency = 0.20

    highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    highlight.OutlineTransparency = 0

    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Enabled = ESPEnabled

    highlight.Parent = Gui

    data.Highlight = highlight

    --====================================================
    -- ROOT / INFO
    --====================================================

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if root then
        local info = Instance.new("BillboardGui")

        info.Name = "JimboJjosESPInfo"
        info.Adornee = root
        info.Size = UDim2.fromOffset(240, 42)
        info.StudsOffset = Vector3.new(0, 3.5, 0)
        info.AlwaysOnTop = true
        info.Enabled = ESPEnabled
        info.Parent = PlayerGui

        local label = Instance.new("TextLabel")

        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        label.TextStrokeTransparency = 0
        label.TextSize = 12
        label.Font = Enum.Font.GothamBold
        label.Text = player.Name
        label.Parent = info

        data.Info = info
        data.Label = label
    end

    data.Character = character
end

--========================================================
-- PLAYER SETUP
--========================================================

local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end

    cleanupESP(player)

    if ESP[player]
        and ESP[player].Connection then

        ESP[player].Connection:Disconnect()
    end

    ESP[player] = {
        Character = nil,
        Highlight = nil,
        Info = nil,
        Label = nil,
        Connection = nil
    }

    -- ВАЖНО:
    -- создаём ESP заново после КАЖДОГО респавна
    ESP[player].Connection =
        player.CharacterAdded:Connect(
            function(character)

                task.spawn(function()

                    -- Ждём загрузки модели
                    local humanoid =
                        character:WaitForChild(
                            "Humanoid",
                            10
                        )

                    if not humanoid then
                        return
                    end

                    task.wait(0.1)

                    if ESP[player] then
                        createESP(
                            player,
                            character
                        )
                    end
                end)
            end
        )

    -- Игрок уже существует
    if player.Character then
        task.spawn(function()
            createESP(
                player,
                player.Character
            )
        end)
    end
end

--========================================================
-- INITIAL PLAYERS
--========================================================

for _, player in ipairs(
    Players:GetPlayers()
) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(
    setupPlayer
)

Players.PlayerRemoving:Connect(
    function(player)

        if CURRENT_TARGET == player then
            CURRENT_TARGET = nil
        end

        if ESP[player]
            and ESP[player].Connection then

            ESP[player].Connection:Disconnect()
        end

        cleanupESP(player)

        ESP[player] = nil
    end
)

--========================================================
-- ESP UPDATE
--========================================================

RunService.RenderStepped:Connect(
    function()

        for player, data in pairs(ESP) do

            local character =
                player.Character

            if not character then

                if data.Highlight then
                    data.Highlight.Enabled = false
                end

                if data.Info then
                    data.Info.Enabled = false
                end

                continue
            end

            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if not humanoid
                or humanoid.Health <= 0 then

                if data.Highlight then
                    data.Highlight.Enabled = false
                end

                if data.Info then
                    data.Info.Enabled = false
                end

                continue
            end

            if data.Highlight then

                data.Highlight.Adornee =
                    character

                data.Highlight.Enabled =
                    ESPEnabled

                data.Highlight.DepthMode =
                    Enum.HighlightDepthMode.AlwaysOnTop
            end

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if root and data.Info then

                data.Info.Adornee = root
                data.Info.Enabled =
                    ESPEnabled

                if data.Label then

                    local myCharacter =
                        LocalPlayer.Character

                    local myRoot =
                        myCharacter
                        and myCharacter:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if myRoot then

                        local distance =
                            (
                                myRoot.Position
                                - root.Position
                            ).Magnitude

                        data.Label.Text =
                            player.Name
                            .. " | "
                            .. math.floor(distance)
                            .. "m"
                    else
                        data.Label.Text =
                            player.Name
                    end
                end
            end
        end
    end
)

--========================================================
-- WALL CHECK
--========================================================

local function visible(player)
    if not isAlive(player) then
        return false
    end

    local camera =
        workspace.CurrentCamera

    if not camera then
        return false
    end

    local character =
        player.Character

    local target =
        getAimPart(player)

    if not character or not target then
        return false
    end

    local origin =
        camera.CFrame.Position

    local direction =
        target.Position - origin

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        LocalPlayer.Character
    }

    params.IgnoreWater = true

    local result =
        workspace:Raycast(
            origin,
            direction,
            params
        )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(
        character
    )
end

--========================================================
-- FIND TARGET
--========================================================

local function findTarget()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local viewport =
        camera.ViewportSize

    local center =
        Vector2.new(
            viewport.X * 0.5,
            viewport.Y * 0.5
        )

    local selected = nil
    local bestDistance = FOV

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and isAlive(player) then

            local target =
                getAimPart(player)

            if target then

                local screen,
                    onScreen =
                    camera:WorldToViewportPoint(
                        target.Position
                    )

                if onScreen
                    and screen.Z > 0 then

                    local point =
                        Vector2.new(
                            screen.X,
                            screen.Y
                        )

                    local distance =
                        (point - center).Magnitude

                    if distance <= bestDistance
                        and visible(player) then

                        bestDistance =
                            distance

                        selected =
                            player
                    end
                end
            end
        end
    end

    return selected
end

--========================================================
-- AIM
--========================================================

local function aimAt(player)

    if not isAlive(player) then
        return false
    end

    -- За стеной отпускаем
    if not visible(player) then
        return false
    end

    local camera =
        workspace.CurrentCamera

    local target =
        getAimPart(player)

    if not camera or not target then
        return false
    end

    local cameraPosition =
        camera.CFrame.Position

    local desired =
        CFrame.lookAt(
            cameraPosition,
            target.Position,
            camera.CFrame.UpVector
        )

    camera.CFrame =
        desired

    return true
end

--========================================================
-- AIM LOOP
--========================================================

pcall(function()
    RunService:UnbindFromRenderStep(
        "JimboJjosAimbot"
    )
end)

RunService:BindToRenderStep(
    "JimboJjosAimbot",
    Enum.RenderPriority.Camera.Value + 1,
    function()

        if not AimbotEnabled then
            CURRENT_TARGET = nil
            return
        end

        -- Удерживаем текущую цель
        if CURRENT_TARGET then

            if isAlive(CURRENT_TARGET)
                and visible(CURRENT_TARGET) then

                aimAt(CURRENT_TARGET)
                return
            end

            CURRENT_TARGET = nil
        end

        -- Новый захват
        local target =
            findTarget()

        if target then
            CURRENT_TARGET =
                target

            aimAt(
                CURRENT_TARGET
            )
        end
    end
)

